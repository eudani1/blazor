@page "/produtos"

<h3>Produtos</h3>

<div class="row">
	<div class="col-md-4">
		<EditForm Model="novoProduto" OnValidSubmit="AdicionarProduto" class="card card-body">
			<DataAnnotationsValidator />

			<label class="form-label">Nome</label>
			<InputText class="form-control" @bind-Value="novoProduto.Nome" />
			<ValidationMessage For="() => novoProduto.Nome" class="text-danger" />

			<label class="form-label mt-2">Preço</label>
			<InputNumber class="form-control" @bind-Value="novoProduto.Preco"
						 ParsingErrorMessage="O preço deve ser um número válido." />
			<ValidationMessage For="() => novoProduto.Preco" class="text-danger" />

			<label class="form-label mt-2">Quantidade</label>
			<InputNumber class="form-control" @bind-Value="novoProduto.Quantidade"
						 ParsingErrorMessage="A quantidade deve ser um número inteiro válido." />
			<ValidationMessage For="() => novoProduto.Quantidade" class="text-danger" />

			<button type="submit" class="btn btn-primary mt-3">Adicionar Produto</button>
		</EditForm>
	</div>

	<div class="col-md-8">
		@if (produtos.Count == 0)
		{
			<p class="text-muted">Nenhum produto cadastrado.</p>
		}
		else
		{
			<table class="table table-striped">
				<thead>
					<tr>
						<th scope="col">Nome</th>
						<th scope="col">Preço</th>
						<th scope="col">Quantidade</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var p in produtos)
					{
						<tr>
							<td>@p.Nome</td>
							<td>@p.Preco</td>
							<td>@p.Quantidade</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
</div>

@code {
	private Produto novoProduto = new();

	private List<Produto> produtos = new();

	private void AdicionarProduto()
	{
		produtos.Add(novoProduto);
		novoProduto = new Produto();
	}
}
